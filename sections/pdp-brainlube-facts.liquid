{{ 'section-pdp-brainlube-facts.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign full_width = section.settings.enable_full_width
-%}

<div
  id="{{ section.id }}"
  class="pt pb sm-pt sm-pb container pdp-facts color-{{ section.settings.color_scheme }}{% if full_width %} edge-to-edge{% endif %}"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
    --pdp-facts-radius: {{ section.settings.border_radius | append: 'px' }};
  ">

  <div class="pdp-facts__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'section_header' -%}
          <div class="pdp-facts__header" {{ block.shopify_attributes }}>
            {%- render 'section-header',
              text_align: block.settings.text_alignment,
              subtitle_tag: block.settings.subtitle_tag,
              title_tag: block.settings.title_tag,
              subtitle: block.settings.subtitle,
              title: block.settings.title,
              text: block.settings.text,
              size_multiplier: block.settings.size_multiplier,
              sm_size_multiplier: block.settings.sm_size_multiplier -%}
          </div>

        {%- when 'comparison_group' -%}
          {%- liquid
            assign max_value = block.settings.max_value
            assign v1 = block.settings.item_1_value
            assign v2 = block.settings.item_2_value
            assign w1 = v1 | times: 1.0 | divided_by: max_value | times: 100
            assign w2 = v2 | times: 1.0 | divided_by: max_value | times: 100
          -%}
          <div class="pdp-facts__panel pdp-facts__comparison" {{ block.shopify_attributes }}>
            {%- unless block.settings.eyebrow == blank -%}
              <p class="pdp-facts__eyebrow size--tiny">{{ block.settings.eyebrow }}</p>
            {%- endunless -%}
            {%- unless block.settings.lede == blank -%}
              <p class="pdp-facts__lede">{{ block.settings.lede }}</p>
            {%- endunless -%}

            <div class="pdp-facts__bar-row pdp-facts__bar-row--brand">
              <div class="pdp-facts__bar-label">
                <span class="pdp-facts__bar-name">{{ block.settings.item_1_label }}</span>
                <span class="pdp-facts__bar-value">{{ block.settings.item_1_value }}&nbsp;{{ block.settings.unit }}</span>
              </div>
              <div class="pdp-facts__bar-track">
                <div class="pdp-facts__bar-fill pdp-facts__bar-fill--brand" style="--bar-width: {{ w1 }}%;"></div>
              </div>
            </div>

            <div class="pdp-facts__bar-row">
              <div class="pdp-facts__bar-label">
                <span class="pdp-facts__bar-name">{{ block.settings.item_2_label }}</span>
                <span class="pdp-facts__bar-value">{{ block.settings.item_2_value }}&nbsp;{{ block.settings.unit }}</span>
              </div>
              <div class="pdp-facts__bar-track">
                <div class="pdp-facts__bar-fill" style="--bar-width: {{ w2 }}%;"></div>
              </div>
            </div>

            {%- unless block.settings.helper_text == blank -%}
              <div class="pdp-facts__helper rte size--small">{{ block.settings.helper_text }}</div>
            {%- endunless -%}
          </div>

        {%- when 'callout' -%}
          <div class="pdp-facts__panel text--boxed pdp-facts__callout" {{ block.shopify_attributes }}>
            {%- unless block.settings.title == blank -%}
              <p class="pdp-facts__callout-title">{{ block.settings.title }}</p>
            {%- endunless -%}
            {%- unless block.settings.body == blank -%}
              <div class="rte size--small">{{ block.settings.body }}</div>
            {%- endunless -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "PDP — BRAiNLUBE facts",
  "class": "section--pdp-brainlube-facts",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "default",
      "label": "t:sections.colors.color_scheme.label"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Panel corner radius",
      "unit": "px",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "t:sections.layout.section_width.full_width",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.layout.margin_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.layout.margin_bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.layout.margin_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.layout.margin_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "section_header",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "subtitle", "label": "Subheading" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alignment",
          "default": "text-align-left",
          "options": [
            { "value": "text-align-left", "label": "Left" },
            { "value": "text-align-center", "label": "Center" }
          ]
        }
      ]
    },
    {
      "type": "comparison_group",
      "name": "Comparison bars",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Caffeine per can" },
        { "type": "text", "id": "lede", "label": "Lede", "default": "Enough to work. Not enough to wreck you." },
        { "type": "header", "content": "Row 1 (highlighted)" },
        { "type": "text", "id": "item_1_label", "label": "Label", "default": "BRAiNLUBE" },
        { "type": "range", "id": "item_1_value", "label": "Value", "min": 0, "max": 400, "step": 5, "default": 130 },
        { "type": "header", "content": "Row 2" },
        { "type": "text", "id": "item_2_label", "label": "Label", "default": "Most \"performance\" energy drinks" },
        { "type": "range", "id": "item_2_value", "label": "Value", "min": 0, "max": 400, "step": 5, "default": 200 },
        { "type": "header", "content": "Scale" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "mg" },
        { "type": "range", "id": "max_value", "label": "Scale max (100% bar width)", "min": 50, "max": 500, "step": 10, "default": 200 },
        { "type": "richtext", "id": "helper_text", "label": "Helper text below bars" }
      ]
    },
    {
      "type": "callout",
      "name": "Honesty callout",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Let's talk about the sugar" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP — BRAiNLUBE facts",
      "blocks": [
        { "type": "section_header" },
        { "type": "comparison_group" },
        { "type": "callout" }
      ]
    }
  ]
}
{% endschema %}
